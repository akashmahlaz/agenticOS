// Prisma schema for agenticOS
// Neon PostgreSQL

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Document — RAG knowledge base
// Each document has a vector embedding (1536-d for OpenAI text-embedding-3-small)
// Falls back to full-text search when no embedding API is configured
// ──────────────────────────────────────────────
model Document {
  id String @id @default(cuid())
  title String
  content String @db.Text
  source String? // URL, file name, or note
  sourceType String @default("manual") // manual | url | file | note
  tags String[] @default([])
  chunkCount Int @default(1)
  // 1536-d vector for OpenAI text-embedding-3-small
  // Use Unsupported type since pgvector is not natively supported in Prisma
  embedding Float[] @default([])
  embeddingModel String? // "text-embedding-3-small" | "text-embedding-ada-002" | "fallback-hash"
  hasRealEmbedding Boolean @default(false) // true = vector search, false = full-text only
  // Full-text search
  tsv Unsupported("tsvector")?
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, sourceType])
  @@index([userId, updatedAt])
  @@index([userId, hasRealEmbedding])
}

// ──────────────────────────────────────────────
// MemoryFile — durable per-user memory files (USER.md, MEMORY.md, IDENTITY.md, SOUL.md)
// ──────────────────────────────────────────────
model MemoryFile {
  id     String @id @default(cuid())
  path   String // e.g. "USER.md", "MEMORY.md", "IDENTITY.md", "SOUL.md"
  title  String
  content String @db.Text
  version Int @default(1)
  charCount Int @default(0)
  lastEditedBy String? // "user" | "agent" | "system"
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, path])
  @@index([userId])
  @@index([userId, updatedAt])
}

// ──────────────────────────────────────────────
// MemoryEntry — individual facts with provenance
// ──────────────────────────────────────────────
model MemoryEntry {
  id String @id @default(cuid())
  fact String @db.Text
  provenance String // observed_from_source | inferred_by_model | confirmed_by_user | imported_from_transcript
  category String? // e.g. "user", "project", "preference", "fact"
  importance Int @default(5) // 1-10
  confidence Float @default(0.8) // 0-1
  sourceSessionId String? // which session introduced this
  sourceMessageId String? // which message
  userId String
  createdAt DateTime @default(now())
  lastAccessedAt DateTime?

  @@index([userId])
  @@index([userId, importance])
  @@index([userId, category])
  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────
// MemoryDaily — daily notes (memory/YYYY-MM-DD.md)
// ──────────────────────────────────────────────
model MemoryDaily {
  id String @id @default(cuid())
  date String @unique // YYYY-MM-DD
  content String @db.Text
  summary String? // auto-generated
  entryCount Int @default(0)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
}

// ──────────────────────────────────────────────
// User — with auth
// ──────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // hashed with bcrypt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
}

// ──────────────────────────────────────────────
// Session — a single chat thread
// ──────────────────────────────────────────────
model Session {
  id     String @id @default(cuid())
  title  String @default("New Chat")
  model  String @default("MiniMax-M2")

  // Temporary chat: not saved to history, not used for training
  isTemporary Boolean @default(false)

  // Shareable chat: public read-only URL
  isShared   Boolean @default(false)
  shareToken String? @unique

  // Per-message feedback ("up" / "down")
  feedback  Json @default("{}")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([shareToken])
}

// ──────────────────────────────────────────────
// Message — a single turn in a session
// ──────────────────────────────────────────────
model Message {
  id   String @id @default(cuid())
  role String // "user" | "assistant" | "system" | "tool"

  content         String   @db.Text
  reasoningSteps  Json     @default("[]")
  toolCalls       Json     @default("[]")
  citations       Json     @default("[]")
  usage           Json?

  model String?
  agent String? // agent name used

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}
